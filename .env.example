# =============================================================
#  Backend environment variables
# =============================================================
#
# Local dev: copy to .env, fill in values, run `npm run dev`
# Production: set these in your hosting provider's dashboard
#             (Render / Railway / Vercel / Fly.io)
#
# -------------------------------------------------------------

PORT=5000
NODE_ENV=production

# MongoDB connection string (REQUIRED)
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DB_NAME?retryWrites=true&w=majority

# JWT secret (REQUIRED) — long random string
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Default super-admin (created on first server start)
ADMIN_EMAIL=yousufconsultancy46@gmail.com
ADMIN_PASSWORD=0571446@#

# CORS — comma-separated allowed origins (REQUIRED in production)
# Local:      http://localhost:5173
# Production: https://your-frontend.vercel.app
# Multiple:   http://localhost:5173,https://your-frontend.vercel.app
CORS_ORIGIN=http://localhost:5173

# Cloudinary (REQUIRED in production for image uploads)
# Get from https://cloudinary.com/console (free tier: 25GB storage)
# Format: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=
